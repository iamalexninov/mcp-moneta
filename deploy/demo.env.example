# Copy to the repo root as .env:  cp deploy/demo.env.example .env
# Public hostname pointing at this server. No domain? Use <server-ip-with-dashes>.sslip.io,
# e.g. server IP 203.0.113.10  ->  PUBLIC_HOST=203-0-113-10.sslip.io
PUBLIC_HOST=203-0-113-10.sslip.io

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_SESSION_SECRET=

# Filled in after: docker compose ... run --rm gateway python -m gateway.cli register-mcp-server
MCP_CLIENT_ID=moneta-mcp-server
MCP_CLIENT_SECRET=
