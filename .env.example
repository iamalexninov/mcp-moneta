# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env. In production load these from a
# secret manager (Azure Key Vault, AWS Secrets Manager, Vault...).
# ---------------------------------------------------------------------------

# ---- Gateway (REST API + OAuth server + admin panel)
GATEWAY_ENVIRONMENT=dev                    # "prod" enforces HTTPS, real secrets, SQL Server
GATEWAY_PUBLIC_URL=http://localhost:8000   # prod: https://ai.example.bg
GATEWAY_MCP_RESOURCE_URL=http://localhost:8001/mcp   # prod: https://ai.example.bg/mcp
# python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_SESSION_SECRET=dev-only-change-me-dev-only-change-me-0000
GATEWAY_KEYS_DIR=./keys

# Dev: SQLite. Prod: SQL Server with the least-privileged ai_gateway_app login.
# Quote the value: it contains '&'.
GATEWAY_DATABASE_URL="sqlite:///./moneta_dev.db"
# GATEWAY_DATABASE_URL="mssql+pyodbc://ai_gateway_app:<password>@sql01.internal:1433/MonetaAI?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes"
# GATEWAY_DB_SCHEMA=ai_gateway
# GATEWAY_AUTO_CREATE_TABLES=false

# ---- MCP server
MCP_PUBLIC_URL=http://localhost:8001/mcp   # must equal GATEWAY_MCP_RESOURCE_URL
MCP_ISSUER_URL=http://localhost:8000       # must equal GATEWAY_PUBLIC_URL
MCP_GATEWAY_INTERNAL_URL=http://localhost:8000
MCP_CLIENT_ID=moneta-mcp-server
MCP_CLIENT_SECRET=                         # from: python -m gateway.cli register-mcp-server
# MCP_ALLOWED_HOSTS=["ai.example.bg"]

# ---- docker compose only
MSSQL_SA_PASSWORD=
PUBLIC_HOST=ai.example.bg
